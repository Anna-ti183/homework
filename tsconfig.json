{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node", "jest"],
  
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },

  "files": ["index.d.ts"], //path (e.g.: "src/types/index.d.ts")
    
  "include": ["src/**/*", "index.d.ts"],
  "exclude": ["_tests_", "dist", "node_modules"]
}
